# Public browser-safe configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase access (never expose with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Owner accounts: trusted configuration, never user-editable profile metadata.
# Other users need an approved ageless_admin_access_requests record.
AGELESS_OWNER_EMAILS=AgeLess@e-Valuate.biz
# Optional single owner fallback when OWNER_EMAILS is unset.
AGELESS_ADMIN_APPROVER_EMAIL=

# Public production origin and explicit checkout kill switch
AGELESS_PUBLIC_ORIGIN=https://www.ageless-peptides.store
AGELESS_CHECKOUT_ENABLED=false

# PayPal sandbox credentials
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=

# PayPal live credentials
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=

# Backward-compatible sandbox-only variables (optional)
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

